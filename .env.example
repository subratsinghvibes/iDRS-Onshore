# Django Environment Configuration
# Copy this file to .env and update the values for your environment

# Security Settings
SECRET_KEY=your-very-secure-secret-key-here-minimum-50-characters-long-with-special-chars
DEBUG=False
USE_HTTPS=False

# Host Configuration
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# Database Configuration
DATABASE_URL=sqlite:///db.sqlite3
# For PostgreSQL: DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# HTTPS Security Settings (only set these to True if using HTTPS)
SECURE_HSTS_SECONDS=31536000

# Development Override (set to True for local development)
# DEBUG=True
# USE_HTTPS=False