# =============================================================================
# IDRS v11 – Docker environment file
# Copy this file to .env on the target VM and edit before running the app.
# =============================================================================
# IMPORTANT: This file is read by docker-compose.yml at runtime.
#            Do NOT commit a filled-in .env file to version control.

# ---- Django Security --------------------------------------------------------
# Generate a strong key with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-very-long-random-string-at-least-50-characters

# Set to False in production
DEBUG=False

# Comma-separated list of allowed hostnames / IP addresses
# Add the VM's actual IP or hostname here, e.g. 192.168.1.100,idrs.mycompany.local
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ---- Database ---------------------------------------------------------------
# SQLite (default — data stored in the 'idrs_data' Docker volume)
DATABASE_URL=sqlite:////app/data/db.sqlite3

# PostgreSQL (optional — uncomment and fill in details, also enable 'db' service in docker-compose.yml)
# DATABASE_URL=postgresql://idrs_user:idrs_password@db:5432/idrs_db

# ---- Django Superuser (created automatically on first boot) -----------------
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@idrs.local
DJANGO_SUPERUSER_PASSWORD=ChangeMe@2024!

# ---- LDAP Authentication (optional — leave defaults to disable LDAP) --------
# Set LDAP_SERVER to your actual Active Directory server IP
LDAP_SERVER=ldap://127.0.0.1:389
LDAP_BASE_DN=DC=ONGC,DC=ONGCGroup,DC=co,DC=in
LDAP_USE_SSL=False
LDAP_VERIFY_SSL=False
LDAP_DOMAIN=ongcgroup.co.in
